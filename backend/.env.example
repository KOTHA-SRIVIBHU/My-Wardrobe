# Copy to backend/.env and fill in. Everything has a working local default.

# "development" or "production". Production refuses to start with AUTH_MODE=dev.
ENVIRONMENT=development

# Local default is a SQLite file. For Supabase use the connection string from
# Project Settings -> Database (the "Session pooler" URI works on free tier).
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./closetiq.db

# "dev" = no login, every request acts as DEV_USER_ID (local use only).
# "supabase" = require a Supabase Auth access token on every request.
AUTH_MODE=dev
DEV_USER_ID=dev-user

# Supabase project (needed for AUTH_MODE=supabase and/or STORAGE_MODE=supabase).
# SUPABASE_URL=https://xxxx.supabase.co
# Only needed for projects still using the legacy HS256 JWT secret.
# SUPABASE_JWT_SECRET=
# Service role key: backend only, never ship it to the frontend.
# SUPABASE_SERVICE_KEY=

# "local" stores photos in backend/uploads; "supabase" uses Supabase Storage.
STORAGE_MODE=local
SUPABASE_BUCKET=garment-images

# Groq (free tier) powers photo classification and outfit explanations.
# Leave empty to run without AI; everything else keeps working.
# Get a key at https://console.groq.com/keys. Groq only bills if you upgrade the plan yourself.
GROQ_API_KEY=
# Model IDs change over time; check https://console.groq.com/docs/models.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Fair-use limits (sign-up is open in production). 0 disables a limit.
AI_DAILY_LIMIT_PER_USER=40
RATE_LIMIT_PER_MINUTE=240
MAX_GARMENTS_PER_USER=1500

# Optional: run the test suite against Postgres (e.g. your Supabase database).
# Tests use their own "closetiq_test" schema and never touch the app's tables.
# TEST_DATABASE_URL=postgresql://...
