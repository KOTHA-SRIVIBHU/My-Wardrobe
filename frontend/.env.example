# Copy to frontend/.env.local. Leave everything empty for local development.

# Backend URL. Empty = same origin (the Vite dev server proxies /api to :8000).
VITE_API_URL=

# Set both to require login via Supabase Auth (backend must use AUTH_MODE=supabase).
# The anon/publishable key is safe to ship to the browser; never put the service key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
